# Chaîne de connexion Neon (fournie par l'intégration Neon de Vercel)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Secret pour signer les sessions (au moins 32 caractères aléatoires)
# Générer : openssl rand -base64 32
AUTH_SECRET=

# Mettre à "false" une fois vos deux comptes créés : empêche de créer de nouveaux comptes partagés
ALLOW_NEW_LEDGERS=true
